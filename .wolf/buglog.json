      "error_message": "status line columns shifted; effort/repo fields landed in wrong variables when optional fields absent",
      "file": "~/.claude/statusline.sh",
      "root_cause": "bash `read` with IFS=$\t collapses consecutive/empty tab-delimited fields because tab is IFS whitespace, so absent jq fields (effort, thinking) shifted every column",
      "fix": "replaced @tsv + IFS read with `while IFS= read -r line; do F+=(...); done` over jq `.[]` (one element per line), which preserves empty fields",
      "tags": [
        "bash",
        "ifs",
        "jq",
        "statusline",
        "parsing"
      ],
